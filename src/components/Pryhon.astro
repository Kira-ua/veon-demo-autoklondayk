---
// Car import from the USA: a separate navy band (company.business_lines[4]). No invented terms or prices.
// Photo: the text-free part of the client's own banner «Пригон авто з США під ключ» (local copy, cropped).
import Section from "./Section.astro";
import FutureLink from "./FutureLink.astro";
import CallButton from "./CallButton.astro";
import ViberButton from "./ViberButton.astro";
import { SOON } from "../data/site";
import { asset } from "../lib/asset";
---
<Section id="pryhon" class="pryhon on-dark" rec="R-006">
  <div class="wrap pryhon__grid">
    <div class="pryhon__head">
      <h2 class="h2">Пригон авто з США під ключ</h2>
      <p class="lead pryhon__lead">Окремий напрям AutoKlondayk: викуп авто на аукціоні в США, доставка в Україну і розмитнення.</p>
      <ul class="pryhon__auctions" aria-label="Аукціони">
        <li>Copart</li><li>IAAI</li><li>Manheim</li>
      </ul>
    </div>
    <div class="pryhon__side">
      <picture class="pryhon__pic">
        <img src={asset("img/pryhon-1016.webp")} srcset={`${asset("img/pryhon-640.webp")} 640w, ${asset("img/pryhon-1016.webp")} 1016w`}
          sizes="(min-width: 1200px) 760px, 100vw" width="1016" height="394" alt="Авто в порту перед відправкою — зображення з банера AutoKlondayk" loading="lazy" decoding="async" />
      </picture>
      <ol class="route">
        <li class="route__stage"><h3 class="route__title">Викуп</h3><p>Авто з аукціонів Copart, IAAI або Manheim.</p></li>
        <li class="route__stage"><h3 class="route__title">Доставка</h3><p>Зі США в Україну.</p></li>
        <li class="route__stage"><h3 class="route__title">Розмитнення</h3><p>Оформлення авто в Україні.</p></li>
      </ol>
      <div class="cta-row pryhon__cta">
        <CallButton label="Запитати про пригон" />
        <ViberButton label="Viber" />
        <FutureLink note={SOON} class="textlink">Детальніше про пригон</FutureLink>
      </div>
    </div>
  </div>
</Section>
