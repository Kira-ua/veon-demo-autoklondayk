---
// First screen: H1, the «Знайти деталь» panel with three ways (VIN open), and the VIN ruler signature.
import Section from "./Section.astro";
import FutureLink from "./FutureLink.astro";
import CallButton from "./CallButton.astro";
import ViberButton from "./ViberButton.astro";
import { contacts } from "../data/site";

interface Props { h1: string; }
const { h1 } = Astro.props;
// «VIN-кодом» не розривається на дефісі; видимий текст H1 — дослівно з veon-concept.
const [h1Before, h1After] = h1.includes("VIN-кодом") ? h1.split("VIN-кодом") : [h1, null];

// Явний приклад VIN (не дані клієнта): 3 · 6 · 8 символів.
const vin = "WVWZZZ1KZBW000017".split("");
const vinGroups = [
  { id: "wmi", label: "Виробник", from: 1, to: 3, text: "Символи 1–3 — код виробника: країна і завод, що випустили авто." },
  { id: "vds", label: "Модель, кузов, двигун", from: 4, to: 9, text: "Символи 4–9 описують модель, кузов і двигун. За ними перевіряють, чи підійде деталь." },
  { id: "vis", label: "Рік і серійний номер", from: 10, to: 17, text: "Символи 10–17 — модельний рік, завод і серійний номер саме вашої машини." },
];
const groupOf = (i: number) => vinGroups.find((g) => i >= g.from && i <= g.to)!.id;

const ways = [
  { id: "vin", label: "За VIN" },
  { id: "kod", label: "За кодом" },
  { id: "avto", label: "За авто" },
];
---
<Section id="pidbir" class="hero on-dark" label="Підбір запчастин">
  <div class="hero__grid wrap">
    <h1 class="hero__title">{h1After === null ? h1 : <>{h1Before}<span class="nobr">VIN-кодом</span>{h1After}</>}</h1>
    <div class="hero__lead">
      <p>Офіс видачі на Подолі, Кирилівська, 60П. Доставка Новою Поштою по всій Україні.</p>
      <p class="hero__hours">{contacts.hours}</p>
    </div>

    <div class="finder" data-rec="R-001,G-R002" data-tabs>
      <h2 class="finder__title">Знайти деталь</h2>
      <div class="finder__tabs" role="tablist" aria-label="Спосіб підбору">
        <span class="finder__indicator" aria-hidden="true"></span>
        {ways.map((w, i) => (
          <button class="finder__tab" type="button" role="tab" id={`tab-${w.id}`} aria-controls={`way-${w.id}`}
            aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-rec={w.id === "vin" ? "R-003" : undefined}>{w.label}</button>
        ))}
      </div>

      <div class="finder__panel" id="way-vin" role="tabpanel" aria-labelledby="tab-vin" data-rec="R-003">
        <h3 class="finder__ptitle">За VIN-кодом</h3>
        <p class="finder__hint">VIN — 17 символів, є у свідоцтві про реєстрацію (техпаспорті). Менеджер перевірить сумісність.</p>
        <div class="finder__actions">
          <CallButton />
          <ViberButton label="Надіслати VIN у Viber" />
        </div>
      </div>

      <div class="finder__panel" id="way-kod" role="tabpanel" aria-labelledby="tab-kod">
        <h3 class="finder__ptitle">За кодом деталі</h3>
        <div class="field">
          <label class="field__label" for="part-code">Артикул деталі</label>
          <div class="field__row">
            <input class="field__input" id="part-code" name="part-code" type="text" inputmode="text" autocomplete="off" spellcheck="false" />
            <FutureLink note="Пошук за кодом з'явиться в повній версії сайту" class="future-link--button future-link--end">Знайти</FutureLink>
          </div>
        </div>
        <p class="finder__alt">Або продиктуйте код менеджеру: <a href={contacts.phoneMain.href} data-rec="R-002">{contacts.phoneMain.label}</a> чи <a href={contacts.viber.href} data-rec="R-002">у Viber</a>.</p>
      </div>

      <div class="finder__panel" id="way-avto" role="tabpanel" aria-labelledby="tab-avto">
        <h3 class="finder__ptitle">За маркою і моделлю</h3>
        <div class="finder__fields">
          <div class="field"><label class="field__label" for="car-make">Марка</label><input class="field__input" id="car-make" name="car-make" type="text" autocomplete="off" /></div>
          <div class="field"><label class="field__label" for="car-model">Модель</label><input class="field__input" id="car-model" name="car-model" type="text" autocomplete="off" /></div>
          <div class="field"><label class="field__label" for="car-year">Рік</label><input class="field__input" id="car-year" name="car-year" type="text" inputmode="numeric" autocomplete="off" /></div>
        </div>
        <FutureLink note="Підбір за авто з'явиться в повній версії сайту" class="future-link--button">Підібрати</FutureLink>
        <p class="finder__alt">Або назвіть авто менеджеру: <a href={contacts.phoneMain.href} data-rec="R-002">{contacts.phoneMain.label}</a> чи <a href={contacts.viber.href} data-rec="R-002">у Viber</a>.</p>
      </div>
    </div>

    <div class="vin" data-rec="R-003" data-vin>
      <div class="vin__head">
        <p class="vin__caption">Приклад. Ваш VIN — у техпаспорті</p>
        <p class="vin__explain" aria-live="polite" data-vin-explain>Натисніть на групу символів, щоб дізнатися, що вона означає.</p>
      </div>
      <p class="visually-hidden">Приклад VIN: {vin.join(" ")}</p>
      <div class="vin__grid">
        {vin.map((ch, i) => (
          <span class="vin__cell" aria-hidden="true" data-group={groupOf(i + 1)} style={`--i:${i}`}>{ch}</span>
        ))}
        {vinGroups.map((g) => (
          <button class={`vin__group vin__group--${g.id}`} type="button" data-group={g.id} data-text={g.text} aria-pressed="false">
            <span class="vin__range">{g.from}–{g.to}</span>
            <span class="vin__label">{g.label}</span>
          </button>
        ))}
      </div>
    </div>
  </div>
</Section>
