---
import Base from "../layouts/Base.astro";
import CallButton from "../components/CallButton.astro";
import { asset } from "../lib/asset";
---
<Base lang="uk" title="Сторінку не знайдено | AutoKlondayk" description="Такої сторінки немає. Поверніться на головну AutoKlondayk або зателефонуйте менеджеру.">
  <section class="nf on-dark">
    <div class="wrap nf__inner">
      <p class="nf__code" aria-hidden="true">404</p>
      <h1 class="nf__title">Такої сторінки немає</h1>
      <p class="lead">Поверніться на головну або назвіть деталь менеджеру — він підбере її за VIN.</p>
      <div class="cta-row">
        <a class="btn btn--viber" href={asset("")}><span class="btn__label">На головну</span></a>
        <CallButton />
      </div>
    </div>
  </section>
</Base>
